<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 阶段名 + 历史记录 + 退出 -->
    <LinearLayout
        android:id="@+id/pomoTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/phaseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/cycleText"
                style="@style/TextDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_history"
                app:tint="@color/ink_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pomodoro_records"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/exit"
            android:textColor="@color/rose"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 倒计时区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ringLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="25:00"
            android:textColor="@color/ink"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 中下方按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:background="@drawable/bg_btn_lap"
            android:gravity="center"
            android:text="@string/pomodoro_skip"
            android:textColor="@color/ink_sub"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_btn_start"
            android:elevation="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/pomodoro_start"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:background="@drawable/bg_btn_lap"
            android:gravity="center"
            android:text="@string/pomodoro_reset"
            android:textColor="@color/rose"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
