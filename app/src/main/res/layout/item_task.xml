<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/colorBar"
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_pill_soft" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/TextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/tagRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/carryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_carry"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/carry_ink"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sub"
                style="@style/TextDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnMinus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_circle_soft"
        android:gravity="center"
        android:text="−"
        android:textColor="@color/ink_sub"
        android:textSize="19sp"
        android:visibility="gone" />

    <com.gongkao.checkin.view.CheckCircleView
        android:id="@+id/check"
        android:layout_width="46dp"
        android:layout_height="46dp" />
</LinearLayout>
