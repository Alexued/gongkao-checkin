<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 进度 + 退出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/progressText"
                style="@style/TextDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/exit"
            android:textColor="@color/rose"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/accent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 题面卡：求什么 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/categoryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_soft"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/askText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/givenText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink_sub"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 答案卡：真正的公式 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/answerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:minHeight="150dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextDim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/formula_answer" />

                    <com.gongkao.checkin.view.FormulaView
                        android:id="@+id/formulaView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/tipText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_pill_soft"
                        android:padding="12dp"
                        android:textColor="@color/ink_sub"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 未翻牌时的遮罩 -->
                <LinearLayout
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dash"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/formula_reveal"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/TextDim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/formula_reveal_hint" />
                </LinearLayout>
            </FrameLayout>

            <!-- 符号说明 -->
            <TextView
                android:id="@+id/symbolText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/formula_symbols_prefix"
                android:textColor="@color/ink_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 自评按钮 -->
    <LinearLayout
        android:id="@+id/judgeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/btnVague"
            style="@style/BtnGhost"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="@string/formula_vague"
            android:textColor="@color/carry_ink" />

        <TextView
            android:id="@+id/btnKnown"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/formula_known" />
    </LinearLayout>
</LinearLayout>
