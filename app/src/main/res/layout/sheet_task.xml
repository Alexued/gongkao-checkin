<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/add_task"
        android:textColor="@color/ink"
        android:textSize="19sp" />

    <EditText
        android:id="@+id/inputTitle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:hint="@string/task_title_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/quantityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputTarget"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/task_target_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_dim"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/inputUnit"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_input"
            android:hint="@string/task_unit_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 步骤：有步骤时目标数＝步骤数，上面那行数量/单位会隐藏 -->
    <LinearLayout
        android:id="@+id/subtaskBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btnAddSubtask"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dash"
        android:gravity="center"
        android:text="@string/task_add_subtask"
        android:textColor="@color/accent"
        android:textSize="13.5sp" />

    <!-- 重复方式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipDaily"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/repeat_daily"
            android:textColor="@color/chip_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chipUntil"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/repeat_until"
            android:textColor="@color/chip_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnUntilDate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 颜色 -->
    <LinearLayout
        android:id="@+id/colorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDelete"
            style="@style/BtnGhost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/delete"
            android:textColor="@color/rose"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSave"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.6"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
