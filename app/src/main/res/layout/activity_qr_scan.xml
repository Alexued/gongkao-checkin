<?xml version="1.0" encoding="utf-8"?>
<!-- 自绘扫码页：顶栏（复用 view_topbar）+ 扫码取景框，不用 zxing 自带的 CaptureActivity 界面。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageFill"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_topbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/barcodeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/scanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/device_sync_scan_qr"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
