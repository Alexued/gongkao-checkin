<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageFill"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 进度 + 答题卡 + 退出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/progressText"
                style="@style/TextDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/bank_sheet_open"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/exit"
            android:textColor="@color/rose"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/accent" />

    <!-- 一题一页，左右滑动切上下题 -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/questionPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/btnAction"
            style="@style/BtnGhost"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/bank_swipe_hint" />
    </LinearLayout>
</LinearLayout>
