<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageFill"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 进度 + 退出 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/progressText"
                style="@style/TextDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/elapsedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink_sub"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/exit"
            android:textColor="@color/rose"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/accent" />

    <!-- 题面 -->
    <LinearLayout
        android:id="@+id/questionArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            style="@style/TextDim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/percent_ask" />

        <TextView
            android:id="@+id/percentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="60sp" />

        <!-- 分数输入 -->
        <LinearLayout
            android:id="@+id/fracBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/numText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:minWidth="86dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="40sp" />

            <View
                android:id="@+id/fracBar"
                android:layout_width="104dp"
                android:layout_height="3dp"
                android:layout_marginVertical="6dp"
                android:background="@color/ink" />

            <TextView
                android:id="@+id/denText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:minWidth="86dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="40sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 自制小键盘 -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="16dp">

        <LinearLayout style="@style/KeyRow">
            <TextView style="@style/Key" android:tag="1" android:text="1" />
            <TextView style="@style/Key" android:tag="2" android:text="2" />
            <TextView style="@style/Key" android:tag="3" android:text="3" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">
            <TextView style="@style/Key" android:tag="4" android:text="4" />
            <TextView style="@style/Key" android:tag="5" android:text="5" />
            <TextView style="@style/Key" android:tag="6" android:text="6" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">
            <TextView style="@style/Key" android:tag="7" android:text="7" />
            <TextView style="@style/Key" android:tag="8" android:text="8" />
            <TextView style="@style/Key" android:tag="9" android:text="9" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">
            <TextView
                android:id="@+id/keySwap"
                style="@style/Key"
                android:tag="SWAP"
                android:text="@string/key_swap"
                android:textSize="15sp" />

            <TextView style="@style/Key" android:tag="0" android:text="0" />

            <TextView
                android:id="@+id/keyDel"
                style="@style/Key"
                android:tag="DEL"
                android:text="@string/key_del"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/BtnPrimary"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/key_confirm" />
    </LinearLayout>
</LinearLayout>
