<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/subtaskTitle"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:hint="@string/task_subtask_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnRemoveSubtask"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_soft"
        android:gravity="center"
        android:text="@string/task_remove_subtask"
        android:textColor="@color/rose"
        android:textSize="18sp" />
</LinearLayout>
