<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃主题的底层背景：亮底 + 饱和度更高的大色团。
  卡片是高透白 + 亮边，靠这层的颜色透上来才有「玻璃压在水彩上」的感觉。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#EDE9FF"
                android:endColor="#E6F7F4"
                android:startColor="#E8EEFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 左上蓝紫 -->
    <item
        android:bottom="420dp"
        android:left="-100dp"
        android:right="120dp"
        android:top="-140dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#66A9BEFF"
                android:endColor="#00E8EEFF"
                android:gradientRadius="300dp"
                android:startColor="#B36C8CFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- 右中粉紫 -->
    <item
        android:bottom="240dp"
        android:left="150dp"
        android:right="-130dp"
        android:top="150dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#66E0A9FF"
                android:endColor="#00EDE9FF"
                android:gradientRadius="280dp"
                android:startColor="#A6C08BFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- 底部青绿 -->
    <item
        android:bottom="-140dp"
        android:left="-60dp"
        android:right="80dp"
        android:top="440dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#668FE8DC"
                android:endColor="#00E6F7F4"
                android:gradientRadius="280dp"
                android:startColor="#A635D0BA"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
