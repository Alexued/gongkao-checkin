<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      基础主题（＝「白色」）。调色板走 @color，暗色由 values-night 提供；
      卡片质感走 ?attr/cardFill 这几项，各主题各自覆盖。
    -->
    <style name="Theme.Checkin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_deep</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_sub</item>

        <item name="cardFill">@color/surface</item>
        <item name="cardStroke">@color/transparent</item>
        <item name="cardStrokeWidth">0dp</item>
        <item name="softFill">@color/surface_alt</item>
        <item name="backdropDrawable">@null</item>
        <!-- 白主题的浮层：留一点透，背后模糊才看得见；描边用亮白提玻璃边 -->
        <item name="glassFill">#E8FFFFFF</item>
        <item name="glassStroke">#59FFFFFF</item>
    </style>

    <!-- 黑色：跟白色同结构，调色板由 values-night 换掉 -->
    <style name="Theme.Checkin.Dark" parent="Theme.Checkin">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="cardStroke">@color/divider</item>
        <item name="cardStrokeWidth">1dp</item>
        <item name="glassFill">#D9141821</item>
        <item name="glassStroke">#33FFFFFF</item>
    </style>

    <!--
      高斯模糊：暗调色板 + 半透明卡片 + 底层一张被模糊的彩色背景。
      卡片描边压得很淡，靠透明度和背景的明暗变化区分层级。
    -->
    <style name="Theme.Checkin.Blur" parent="Theme.Checkin">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="cardFill">#B2161A21</item>
        <item name="cardStroke">#26FFFFFF</item>
        <item name="cardStrokeWidth">1dp</item>
        <item name="softFill">#59222A36</item>
        <item name="backdropDrawable">@drawable/bg_backdrop_blur</item>
        <item name="glassFill">#B8121620</item>
        <item name="glassStroke">#40FFFFFF</item>
    </style>

    <!--
      液态玻璃：亮调色板 + 更透的卡片 + 亮边高光 + 饱和渐变背景，
      比高斯模糊更「湿」，边缘更明显。
    -->
    <style name="Theme.Checkin.Liquid" parent="Theme.Checkin">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="cardFill">#A6FFFFFF</item>
        <item name="cardStroke">#8CFFFFFF</item>
        <item name="cardStrokeWidth">1.5dp</item>
        <item name="softFill">#66FFFFFF</item>
        <item name="backdropDrawable">@drawable/bg_backdrop_liquid</item>
        <!-- 液态玻璃最透，靠 1.5dp 亮边撑出「湿」的边缘 -->
        <item name="glassFill">#BFFFFFFF</item>
        <item name="glassStroke">#A6FFFFFF</item>
    </style>

    <!--
      应用内弹层统一主题：窗口全透明、无标题、不带系统进出场动画，
      遮罩和缩放动效全部由 AppDialog 自己画，才能和 app 的动效语汇一致。
    -->
    <style name="Theme.Checkin.Dialog" parent="android:Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 遮罩要盖到状态栏/导航栏下面，否则系统给弹窗窗口填黑边 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextSub">
        <item name="android:textColor">@color/ink_sub</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextDim">
        <item name="android:textColor">@color/ink_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextBigNumber">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="TaskMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <!-- 图标统一 20dp、跟文字留 14dp；tint 走调色板，换主题自动跟着变 -->
        <item name="android:drawablePadding">14dp</item>
        <item name="android:drawableTint">@color/ink_sub</item>
    </style>

    <style name="TabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="TabIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="TabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StatNum">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/ink_dim</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BtnPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BtnGhost">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BtnLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:textColor">@color/ink_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
